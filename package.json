{
    "name": "figma-make-app",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@10.34.5",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "validate": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "format": "oxfmt",
        "check:react-runtime": "node scripts/check-react-runtime-versions.mjs",
        "test:smoke": "playwright test tests/runtime-smoke.spec.ts --project=chromium"
    },
    "dependencies": {
        "lucide-react": "^1.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "recharts": "^3.9.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.0",
        "oxfmt": "^0.2.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "vite": "^8.0.16"
    }
}
